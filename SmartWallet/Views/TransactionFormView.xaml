<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartWallet.ViewModels"
             x:DataType="viewmodels:TransactionFormViewModel"
             x:Class="SmartWallet.Views.TransactionFormView"
             Title="{Binding TitleText}">

    <VerticalStackLayout Spacing="15" Padding="20">
        
        <Label Text="Amount (€)" FontSize="16" FontAttributes="Bold" />
        <Entry Text="{Binding Amount}" Keyboard="Numeric" Placeholder="0" FontSize="24" />

        <Label Text="Category" FontSize="16" FontAttributes="Bold" />
        <Picker ItemsSource="{Binding Categories}" 
                SelectedItem="{Binding SelectedCategory}" 
                Title="Choose category..."
                FontSize="18" />

        <Label Text="Notes" FontSize="16" FontAttributes="Bold" />
        <Entry Text="{Binding Note}" Placeholder="e.g. Weekly groceries..." />

        <Button Text="Save" 
                Command="{Binding SaveCommand}" 
                BackgroundColor="Red"
                CornerRadius="10" 
                FontAttributes="Bold" 
                Padding="15"
                Margin="0,20,0,0">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding IsIncome}"
                             Value="True">
                    <Setter Property="BackgroundColor"
                            Value="Green" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

    </VerticalStackLayout>
</ContentPage>
