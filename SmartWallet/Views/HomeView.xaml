<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartWallet.ViewModels"
             xmlns:models="clr-namespace:SmartWallet.Models.Entities"
             x:DataType="viewmodels:HomeViewModel"
             x:Class="SmartWallet.Views.HomeView"
             Title="Home">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20">

        <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="5" Margin="0,20,0,30">
            <Label Text="Current balance" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />
            <Label Text="{Binding Balance, StringFormat='{0:C2}'}" FontSize="42" FontAttributes="Bold" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,0,0,30">
            <Button Grid.Column="0" Text="+ Add Income" BackgroundColor="{StaticResource IncomeGreen}" CornerRadius="10" FontAttributes="Bold" Command="{Binding AddIncomeCommand}" />
            <Button Grid.Column="1" Text="- Add Expense" BackgroundColor="{StaticResource ExpenseRed}" CornerRadius="10" FontAttributes="Bold" Command="{Binding AddExpenseCommand}" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Label Text="Transaction history" FontSize="18" FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding RecentTransactions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        
                        <Grid>
                            
                            <Border Padding="15" Margin="0,5" StrokeShape="RoundRectangle 10" Stroke="LightGray">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Category}" FontAttributes="Bold" FontSize="16" />
                                        <Label Text="{Binding Note}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    
                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="-"
                                               TextColor="{StaticResource ExpenseRed}"
                                               FontSize="16"
                                               FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsIncome}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="+" />
                                                    <Setter Property="TextColor" Value="{StaticResource IncomeGreen}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Text="{Binding Amount, StringFormat='{0:C2}'}"
                                               TextColor="{StaticResource ExpenseRed}"
                                               FontSize="16"
                                               FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsIncome}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource IncomeGreen}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                            
                        </Grid>
                        
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

    </Grid>
</ContentPage>