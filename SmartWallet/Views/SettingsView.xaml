<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartWallet.ViewModels"
             x:DataType="viewmodels:SettingsViewModel"
             x:Class="SmartWallet.Views.SettingsView"
             Title="Settings"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            
            <VerticalStackLayout Spacing="8">
                <Label Text="SECURITY" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="10,0,0,0" />
                
                <Border Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                    <Grid Padding="15" RowDefinitions="Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePinCommand}" />
                        </Grid.GestureRecognizers>
                        
                        <VerticalStackLayout>
                            <Label Text="Change PIN Code" FontSize="16" TextColor="Black" />
                            <Label Text="Update your 6-digit access code" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="DATA MANAGEMENT" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="10,0,0,0" />
                
                <Border Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid Padding="15" RowDefinitions="Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExportToJsonCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="Export to JSON" FontSize="16" TextColor="Black" />
                                <Label Text="Save your history to a data file" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEEEEE" />

                        <Grid Padding="15" RowDefinitions="Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ImportFromJsonCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="Import from JSON" FontSize="16" TextColor="Black" />
                                <Label Text="Load transactions from a data file" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            
            <VerticalStackLayout Spacing="8">
                <Label Text="ABOUT APP" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="10,0,0,0" />
                
                <Border Stroke="LightGray" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                    <VerticalStackLayout>
                        
                        <Grid Padding="15" ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Version" FontSize="16" TextColor="Black" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="1.0.0" FontSize="16" TextColor="Gray" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EEEEEE" />

                        <Grid Padding="15" ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Developer" FontSize="16" TextColor="Black" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Tomáš Olbert" FontSize="16" TextColor="Gray" VerticalOptions="Center" />
                        </Grid>
                        
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
