<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartWallet.ViewModels"
             x:DataType="viewmodels:ChangePinViewModel"
             x:Class="SmartWallet.Views.ChangePinView"
             Title="Change PIN">

    <ContentPage.Resources>
        <Style x:Key="KeypadButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="75" />
            <Setter Property="HeightRequest" Value="75" />
            <Setter Property="CornerRadius" Value="37" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="BackgroundColor" Value="#F0F0F0" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="30" Padding="30" VerticalOptions="Center" HorizontalOptions="Center">

        <Label Text="{Binding TitleText}" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
               
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />

        <Label Text="{Binding PinDisplay}"
               FontSize="16" 
               TextColor="#333333"
               CharacterSpacing="6" 
               HorizontalOptions="Center" />

        <Label Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" FontAttributes="Bold" />

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto" RowSpacing="15" ColumnSpacing="20" HorizontalOptions="Center" Margin="0, 20, 0, 0">
            <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="1" />
            <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="2" />
            <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="3" />
            
            <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="4" />
            <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="5" />
            <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="6" />
            
            <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="7" />
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="8" />
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource KeypadButton}" Command="{Binding AddDigitCommand}" CommandParameter="9" />
            
            <Button Grid.Row="3" Grid.Column="1" 
                    Text="0" 
                    Style="{StaticResource KeypadButton}" 
                    Command="{Binding AddDigitCommand}" 
                    CommandParameter="0" />
            
            <ImageButton Grid.Row="3" Grid.Column="2" 
                         Source="backspace.png" 
                         BackgroundColor="Transparent"
                         WidthRequest="40"
                         HeightRequest="40"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Command="{Binding RemoveDigitCommand}" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>